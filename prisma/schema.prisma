generator client {
  provider = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Netlify/AWS Lambda functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the running app (Supabase: transaction pooler, port 6543).
  url       = env("DATABASE_URL")
  // Direct connection used for migrations (Supabase: session pooler, port 5432).
  directUrl = env("DIRECT_URL")
}

// ---------- Admin users ----------

enum Role {
  ADMIN // everything, including user management
  HR // careers: jobs and applications
  SALES // leads and quote requests
  EDITOR // blog posts and portfolio projects
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes LeadNote[]
}

// ---------- Leads: contact enquiries and quote requests ----------

enum LeadType {
  CONTACT
  QUOTE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  SPAM
}

model Lead {
  id          String     @id @default(cuid())
  type        LeadType
  status      LeadStatus @default(NEW)
  name        String
  email       String
  phone       String?
  company     String?
  service     String? // service slug or "not-sure"
  budget      String?
  timeline    String?
  message     String
  sourcePage  String?
  consentAt   DateTime
  ipHash      String? // salted hash, never the raw IP
  userAgent   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  notes LeadNote[]

  @@index([status, createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

// ---------- Careers ----------

enum JobKind {
  JOB
  INTERNSHIP
}

enum JobStatus {
  DRAFT // not visible on the site
  PUBLISHED
  CLOSED // visible as closed, no new applications
}

model Job {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  kind             JobKind
  status           JobStatus @default(DRAFT)
  department       String
  location         String // e.g. "Remote · Pune, Maharashtra, India"
  employmentType   String // Full-time, Internship (6 months) ...
  experience       String
  summary          String
  responsibilities String[]
  requirements     String[]
  niceToHave       String[]
  qualifications   String[]
  benefits         String[]
  publishedAt      DateTime?
  closesAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  applications Application[]

  @@index([status, kind])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model Application {
  id           String            @id @default(cuid())
  jobId        String
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  status       ApplicationStatus @default(NEW)
  fullName     String
  email        String
  phone        String
  location     String
  education    String
  experience   String
  skills       String
  portfolioUrl String?
  githubUrl    String?
  linkedinUrl  String?
  coverLetter  String?
  resumeKey    String // storage key, never a public URL
  resumeName   String
  resumeMime   String
  resumeSize   Int
  consentAt    DateTime
  ipHash       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([jobId, status])
}

// ---------- Content ----------

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String // Markdown
  category    String
  coverImage  String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  client      String? // only with written permission
  industry    String
  services    String[]
  summary     String
  challenge   String
  solution    String
  results     String
  techStack   String[]
  coverImage  String?
  liveUrl     String?
  featured    Boolean       @default(false)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
