# ---------------------------------------------------------------
# Mindsoft Tech Solutions — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL.
# Local dev: run `npm run db:start` and keep both values as below.
# Supabase (production): Project → Connect → ORMs → Prisma
#   DATABASE_URL = Transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = Session pooler (port 5432)
DATABASE_URL="postgresql://mindsoft:mindsoft@localhost:5433/mindsoft"
DIRECT_URL="postgresql://mindsoft:mindsoft@localhost:5433/mindsoft"

# Long random string (at least 32 chars) used to sign admin sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Salt used to hash visitor IPs for spam/rate-limit records.
IP_HASH_SALT=""

# First admin account, created by `npm run db:seed`. Change the password after first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Resume storage.
# Production: a PRIVATE Supabase Storage bucket. Project Settings → API Keys:
#   SUPABASE_URL = Project URL, SUPABASE_SERVICE_ROLE_KEY = secret key (server only, never NEXT_PUBLIC_).
# Leave the Supabase values empty locally to store files in UPLOAD_DIR instead.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RESUME_BUCKET="resumes"
UPLOAD_DIR="./storage/resumes"

# Optional: email notifications for new leads/applications (SMTP).
# Leave blank to skip email; submissions are still saved to the database.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_FROM=""
NOTIFY_TO=""

# Optional: Cloudflare Turnstile spam protection. Leave blank to rely on
# honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
