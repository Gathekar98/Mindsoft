# ---------------------------------------------------------------
# Mindsoft Tech Solutions — environment variables
# Copy to .env for local development. On Netlify, add the same names under
# Site configuration → Environment variables. Never commit .env.
# ---------------------------------------------------------------

# Public site URL (used for metadata, sitemap, canonical links)
# Used for local development and preview deployments. The live (production) site
# always uses https://www.mindsofttechsolution.com (see src/lib/site.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Email (Brevo HTTPS API) ----
# 1. brevo.com → Settings → Senders, Domains & Dedicated IPs → add & verify your sender email
# 2. SMTP & API → API Keys → Generate a new API key
# Leave BREVO_API_KEY empty locally to print emails in the terminal instead of sending.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Mindsoft Tech Solutions"

# Inbox that receives contact enquiries and quote requests
NOTIFY_EMAIL=""
# Inbox that receives job applications (optional; defaults to NOTIFY_EMAIL)
CAREERS_EMAIL=""

# Random string used when rate-limiting form submissions (optional).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=""

# Optional: Cloudflare Turnstile spam protection. Leave blank to rely on
# the honeypot field + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
