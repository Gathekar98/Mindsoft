# ---------------------------------------------------------------
# Mindsoft Tech Solutions — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Local dev: run `npm run db:start` and keep this value.
# Production: your managed Postgres (Neon, Supabase, RDS ...) with sslmode=require.
DATABASE_URL="postgresql://mindsoft:mindsoft@localhost:5433/mindsoft"

# Long random string (at least 32 chars) used to sign admin sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Salt used to hash visitor IPs for spam/rate-limit records.
IP_HASH_SALT=""

# First admin account, created by `npm run db:seed`. Change the password after first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Private folder for uploaded resumes (outside /public). In production on
# serverless hosting use S3-compatible storage instead (see README).
UPLOAD_DIR="./storage/resumes"

# Optional: email notifications for new leads/applications (SMTP).
# Leave blank to skip email; submissions are still saved to the database.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_FROM=""
NOTIFY_TO=""

# Optional: Cloudflare Turnstile spam protection. Leave blank to rely on
# honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
